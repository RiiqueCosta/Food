rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. SEGURANÇA GLOBAL: Negar tudo por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // --- FUNÇÕES AUXILIARES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(restaurantId) {
      return isSignedIn() && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- VALIDAÇÕES DE ENTIDADES ---

    function isValidOrder(data) {
      return data.restaurantId is string &&
             data.total is number &&
             data.status in ['pending', 'preparing', 'ready', 'finished', 'canceled'] &&
             data.type in ['pickup', 'table'] &&
             data.customer.name is string &&
             data.customer.name.size() <= 100 &&
             data.customer.phone is string &&
             data.customer.phone.size() <= 20 &&
             data.items is list &&
             data.items.size() > 0 &&
             data.createdAt == request.time;
    }

    // --- COLEÇÕES ---

    // Perfil de Usuário Individual
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Restaurantes
    match /restaurants/{restaurantId} {
      allow read: if true; 
      
      allow create: if isSignedIn() 
                    && incoming().ownerId == request.auth.uid
                    && isValidId(restaurantId);
      
      allow update: if isSignedIn() 
                    && existing().ownerId == request.auth.uid 
                    && incoming().ownerId == request.auth.uid;
    }

    // Categorias e Produtos
    match /restaurants/{restaurantId}/categories/{categoryId} {
      allow read: if true;
      allow write: if isOwner(restaurantId);
    }

    match /restaurants/{restaurantId}/products/{productId} {
      allow read: if true;
      allow write: if isOwner(restaurantId);
    }

    // Pedidos (Extremamente Crítico)
    match /restaurants/{restaurantId}/orders/{orderId} {
      // Somente o dono pode ver
      allow read: if isOwner(restaurantId);
      
      // Qualquer um pode criar, mas validamos os dados
      allow create: if isValidOrder(incoming()) && incoming().restaurantId == restaurantId;
      
      // Somente o dono pode atualizar o status
      allow update: if isOwner(restaurantId) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                    incoming().status in ['pending', 'preparing', 'ready', 'finished', 'canceled'] &&
                    incoming().updatedAt == request.time;
      
      allow delete: if false; 
    }
  }
}
